# GitHub OAuth Configuration
# Create a GitHub OAuth App at: Settings > Developer Settings > OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# The URL where GitHub redirects after login
# For local development: http://localhost:8000/auth/callback
# For Codespaces: https://your-codespace-8000.app.github.dev/auth/callback
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# Session Secret Key (generate a secure random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-string

# Database Configuration
# SQLite database file path (relative or absolute)
DATABASE_PATH=./quiz_app.db

# Quiz Files Configuration
# Path to the directory containing quiz YAML files
QUIZFILES_PATH=./backend

# Frontend URL (for CORS and redirects)
# For local development when running frontend separately: http://localhost:3000
# When backend serves frontend: leave empty or set to same as backend URL
FRONTEND_URL=
