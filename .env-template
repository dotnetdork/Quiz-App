# GitHub OAuth Configuration
# Create a GitHub OAuth App at: GitHub Settings > Developer Settings > OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# The URL where GitHub redirects after login
# Must match EXACTLY what you set in your GitHub OAuth App settings
# For local development: http://localhost:8000/auth/callback
# For Codespaces: https://your-codespace-8000.app.github.dev/auth/callback
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# Session Secret Key (generate a secure random string)
# Generate with:
#   Linux/Mac: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Windows:   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-string

# Database Configuration
# SQLite database file path (relative or absolute)
DATABASE_PATH=./quiz_app.db

# Quiz Files Configuration
# Path to the directory containing quiz YAML files
# Since the server runs from the backend/ directory, use "." (current directory)
QUIZFILES_PATH=.

# Frontend URL (for CORS and redirects)
# For local development when running frontend separately: http://localhost:3000
# When backend serves frontend: leave empty or set to same as backend URL
FRONTEND_URL=

# AI Course Extension ("Build Real Stuff") Configuration
# API key from OpenRouter's console: https://openrouter.ai (Account > API Keys).
# We route through OpenRouter rather than DeepSeek's own API -- it's a
# unified, OpenAI-compatible gateway that proxies to many providers
# (including DeepSeek) under one key. This is the same key already used in
# this project's Continue.dev config.yaml for in-IDE coding, so this one
# key is the entire class's AI budget across both surfaces -- keep it out
# of version control the same way the GitHub secrets above are.
# Used by backend/ai_routes.py for the AI tutor, rubric grading, and
# debug_rescue bug generation (see docs/AI-COURSE-EXTENSION-PLAN.md).
OPENROUTER_API_KEY=your_openrouter_api_key_here
